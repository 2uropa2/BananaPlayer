// Windows resource script. Only Windows RC understands this file;
// CMake wires it up on WIN32 builds.
#include <winver.h>

// Icon ID picked up by Explorer, taskbar, alt-tab. IDI_APPICON is also
// referenced from main.cpp via LoadIconW for the window title bar.
#define IDI_APPICON 101
IDI_APPICON ICON "icon.ico"

// Version info block shows up in File Properties -> Details.
#define APP_VERSION       0,1,0,0
#define APP_VERSION_STR   "0.1.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION
 PRODUCTVERSION APP_VERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Vela"
            VALUE "FileDescription",  "Vela Player"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "Vela"
            VALUE "OriginalFilename", "Vela.exe"
            VALUE "ProductName",      "Vela"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
