// Windows resource script. Only Windows RC understands this file;
// CMake wires it up on WIN32 builds.
#include <winver.h>

// Icon ID picked up by Explorer, taskbar, alt-tab. IDI_APPICON is also
// referenced from main.cpp via LoadIconW for the window title bar.
#define IDI_APPICON 101
IDI_APPICON ICON "icon.ico"

// Version info block shows up in File Properties -> Details.
// Bump in lockstep with Version.hpp / CMakeLists.txt project(...) - the
// RC compiler can't include Version.hpp, so keep the three in sync by
// hand. Comma-separated tuple + string are both required by VERSIONINFO.
#define APP_VERSION       1,4,0,0
#define APP_VERSION_STR   "1.4.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION
 PRODUCTVERSION APP_VERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Banana Player"
            VALUE "FileDescription",  "Banana Player - peel and play"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "BananaPlayer"
            VALUE "LegalCopyright",   "MIT License. FFmpeg is LGPL - see LICENSE-3RDPARTY."
            VALUE "OriginalFilename", "BananaPlayer.exe"
            VALUE "ProductName",      "Banana Player"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
